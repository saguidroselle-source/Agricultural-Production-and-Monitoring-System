<template id="production-planting-view">
  <section class="module-view" data-module-view="production" data-view="planting">
    <header class="record-toolbar"><div><span class="eyebrow green">AGRICULTURE MANAGEMENT</span><h2>Agricultural Production & Monitoring — Planting</h2><p class="muted">Crop calendars, planting activities, harvest records, yield measurements, and field monitoring.</p></div></header>
    <div class="panel"><h3>Planting records</h3><p>Crop calendars, planting activities, harvest records, yield measurements, and field monitoring.</p><div class="table-wrap"><table><thead><tr><th>Farmer</th><th>Barangay</th><th>Commodity / crop</th><th>Activity</th><th>Area (hectares)</th></tr></thead><tbody><tr><td colspan="5">Records will be displayed here.</td></tr></tbody></table></div></div>
  </section>
</template>
