<template id="inventory-stock-view">
  <section class="module-view" data-module-view="inventory" data-view="stock">
    <header class="record-toolbar"><div><span class="eyebrow green">AGRICULTURE MANAGEMENT</span><h2>Agricultural Inventory & Supply — Stock</h2><p class="muted">Agricultural inputs, seeds, fertilizers, supplies, warehouse locations, stock movements, and reorder alerts.</p></div></header>
    <div class="panel"><h3>Stock records</h3><p>Agricultural inputs, seeds, fertilizers, supplies, warehouse locations, stock movements, and reorder alerts.</p><div class="table-wrap"><table><thead><tr><th>Item name</th><th>Category</th><th>Quantity on hand</th><th>Unit</th><th>Reorder level</th></tr></thead><tbody><tr><td colspan="5">Records will be displayed here.</td></tr></tbody></table></div></div>
  </section>
</template>
