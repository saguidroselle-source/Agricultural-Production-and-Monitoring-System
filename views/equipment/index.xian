<template id="equipment-index-view">
  <section class="module-view" data-module-view="equipment" data-view="index">
    <header class="record-toolbar"><div><span class="eyebrow green">AGRICULTURE MANAGEMENT</span><h2>Agricultural Equipment & Asset Management</h2><p class="muted">Agricultural machinery, asset assignment, equipment reservations, utilization, and preventive maintenance.</p></div></header>
    <div class="panel"><div class="table-tools"><div class="search-box"><input placeholder="Search equipment..." /></div><span class="record-count">Module records</span></div><div class="table-wrap"><table><thead><tr><th>Equipment name</th><th>Asset code</th><th>Category</th><th>Serial number</th><th>Status</th><th>Assigned location</th><th>Actions</th></tr></thead><tbody><tr><td colspan="7">No records to display in this view yet. Use the module workspace to add records.</td></tr></tbody></table></div></div>
  </section>
</template>
