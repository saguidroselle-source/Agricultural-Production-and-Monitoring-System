<template id="budget-index-view">
  <section class="module-view" data-module-view="budget" data-view="index">
    <header class="record-toolbar"><div><span class="eyebrow green">AGRICULTURE MANAGEMENT</span><h2>Agricultural Budget & Procurement</h2><p class="muted">Annual appropriations, fund sources, procurement plans, obligations, disbursements, and expenditure reports.</p></div></header>
    <div class="panel"><div class="table-tools"><div class="search-box"><input placeholder="Search budget..." /></div><span class="record-count">Module records</span></div><div class="table-wrap"><table><thead><tr><th>Fiscal year</th><th>Fund source</th><th>Project / activity</th><th>Allocated amount</th><th>Obligated amount</th><th>Disbursed amount</th><th>Actions</th></tr></thead><tbody><tr><td colspan="7">No records to display in this view yet. Use the module workspace to add records.</td></tr></tbody></table></div></div>
  </section>
</template>
